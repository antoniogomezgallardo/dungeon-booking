{
  "name": "dungeon-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Dungeon Booking: bookings SaaS for escape rooms and board-game cafés. Built as a Quality Engineering training ground.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter api --filter web --filter @dungeon/shared test",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "pnpm --filter e2e test",
    "test:smoke": "pnpm --filter e2e test:smoke",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate:dev",
    "db:deploy": "pnpm --filter api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
